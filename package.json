{
  "name": "rjwrenovations",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint .",
    "preview": "astro preview",
    "deploy": "npm run build && aws s3 sync dist/ s3://rjwrenovations.co.uk --delete --profile gazzwi86 && aws cloudfront create-invalidation --distribution-id $CF_DIST_ID --paths '/*' --profile gazzwi86",
    "format": "prettier --write src",
    "test:ui": "playwright test",
    "prepare": "npx simple-git-hooks"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "astro": "^6.4.6",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "simple-git-hooks": "^2.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run build"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "sharp@0.34.5": true,
    "simple-git-hooks@2.13.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
