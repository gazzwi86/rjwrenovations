---
export interface Props {
  title?: string
  description?: string
  ogImage?: string
  ogType?: string
}

const {
  title = 'RJW Renovations | Kitchens, Bathrooms & Property Renovations in Henley-in-Arden',
  description = 'Which? Trusted Traders. Quality kitchens, bathrooms, plumbing & more across Warwickshire & the West Midlands. 5-star rated, 100% recommendation rate.',
  ogImage = '/og/home.jpg',
  ogType = 'website',
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RJW Renovations — quality property renovations in Warwickshire" />
    <meta property="og:site_name" content="RJW Renovations" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:image:alt" content="RJW Renovations — property renovations Warwickshire" />

    <!-- Geo -->
    <meta name="geo.region" content="GB-WAR" />
    <meta name="geo.placename" content="Henley-in-Arden, Warwickshire" />
    <meta name="geo.position" content="52.2952;-1.7832" />
    <meta name="ICBM" content="52.2952, -1.7832" />

    <!-- Font preload -->
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0D1117" />

    <!-- JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "HomeAndConstructionBusiness",
        "@id": "https://rjwrenovations.co.uk/#business",
        "name": "RJW Renovations",
        "url": "https://rjwrenovations.co.uk/",
        "telephone": "+447896051540",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "9 Cherry Orchard",
          "addressLocality": "Henley-in-Arden",
          "addressRegion": "Warwickshire",
          "postalCode": "B95 5JW",
          "addressCountry": "GB"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 52.2952,
          "longitude": -1.7832
        },
        "areaServed": [
          {"@type": "Place", "name": "Henley-in-Arden"},
          {"@type": "Place", "name": "Solihull"},
          {"@type": "Place", "name": "Birmingham"},
          {"@type": "Place", "name": "Walsall"},
          {"@type": "Place", "name": "Coventry"},
          {"@type": "Place", "name": "Rugby"},
          {"@type": "Place", "name": "Redditch"},
          {"@type": "Place", "name": "Warwick"},
          {"@type": "Place", "name": "Leamington Spa"},
          {"@type": "Place", "name": "Stratford-upon-Avon"},
          {"@type": "AdministrativeArea", "name": "Warwickshire"},
          {"@type": "AdministrativeArea", "name": "West Midlands"}
        ],
        "foundingDate": "2018",
        "founder": {"@type": "Person", "name": "Rhys Williams"},
        "hasCredential": {
          "@type": "EducationalOccupationalCredential",
          "credentialCategory": "certification",
          "name": "Which? Trusted Traders",
          "url": "https://trustedtraders.which.co.uk/businesses/rjw-renovations/"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5",
          "reviewCount": "17",
          "bestRating": "5",
          "worstRating": "1"
        },
        "priceRange": "££",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
            "opens": "08:30",
            "closes": "19:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": "Saturday",
            "opens": "09:00",
            "closes": "13:00"
          }
        ],
        "sameAs": ["https://trustedtraders.which.co.uk/businesses/rjw-renovations/"]
      }
    </script>

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />

    <!-- Route announcer for screen readers (SPA navigation) -->
    <div id="route-announcer" aria-live="polite" aria-atomic="true" class="sr-only"></div>

    <!-- Scroll reveal -->
    <script>
      const io = new IntersectionObserver(
        (entries) => entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible')
            io.unobserve(e.target)
          }
        }),
        { threshold: 0.1 }
      )
      document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el))
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
