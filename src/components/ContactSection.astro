---
import ContactForm from './ContactForm.tsx'
import ObfuscatedContact from './ObfuscatedContact.tsx'
---

<section id="contact" class="contact section-py" aria-labelledby="contact-h2">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info" data-reveal>
        <span class="eyebrow">Get in Touch</span>
        <h2 id="contact-h2">Get Your Free Quote —<br />Usually Within 24 Hours</h2>
        <p>
          Drop us a message and we'll come back to you with a no-obligation quote. Covering Henley-in-Arden, Solihull, Stratford and across Warwickshire. Prefer to talk? Give Rhys a call directly.
        </p>

        <ul class="contact-details" role="list">
          <li class="contact-detail-item">
            <div class="contact-detail-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1 19.79 19.79 0 0 1 1.62 4.53 2 2 0 0 1 3.62 2.35h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.08 6.08l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.98 17v-.08z"/>
              </svg>
            </div>
            <div>
              <span class="detail-label">Phone</span>
              <ObfuscatedContact type="phone" client:idle linkClass="detail-value detail-link" />
            </div>
          </li>

          <li class="contact-detail-item">
            <div class="contact-detail-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <span class="detail-label">Email</span>
              <ObfuscatedContact type="email" client:idle linkClass="detail-value detail-link" />
            </div>
          </li>

          <li class="contact-detail-item">
            <div class="contact-detail-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <span class="detail-label">Response time</span>
              <span class="detail-value">Within 1 business day</span>
            </div>
          </li>

          <li class="contact-detail-item">
            <div class="contact-detail-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <span class="detail-label">Based in</span>
              <span class="detail-value">Henley-in-Arden, Warwickshire</span>
            </div>
          </li>
        </ul>

        <div class="contact-trust">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          <span>
            <a href="https://trustedtraders.which.co.uk/businesses/rjw-renovations/" rel="noopener noreferrer" target="_blank" class="trust-link">Which? Trusted Traders<span class="sr-only"> (opens in new tab)</span></a>
            &nbsp;accredited. 5★ from 17 verified reviews.
          </span>
        </div>
      </div>

      <div class="contact-form-wrap" data-reveal data-delay="2">
        <div class="form-card">
          <ContactForm client:visible />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact { background: var(--bg); }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 60px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .contact-grid { grid-template-columns: 1fr 1.4fr; gap: 80px; }
  }

  .contact-info { display: flex; flex-direction: column; gap: 20px; }
  .contact-info h2 { margin-bottom: 0; }
  .contact-info > p { font-size: 15px; color: var(--text-muted); line-height: 1.7; }

  .contact-details {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .contact-detail-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .contact-detail-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: rgba(61,110,150,0.12);
    border: 1px solid rgba(61,110,150,0.2);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue-text);
    margin-top: 2px;
  }
  .detail-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-subtle);
    margin-bottom: 2px;
  }
  .detail-value {
    display: block;
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }
  :global(.detail-link) {
    color: var(--text) !important;
    text-decoration: none !important;
    font-size: 15px !important;
    font-weight: 500 !important;
    transition: color 0.15s;
  }
  :global(.detail-link:hover) { color: var(--blue-text) !important; }

  .contact-trust {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    background: var(--surface-1);
    border: 1px solid var(--border-sub);
    border-radius: 10px;
    padding: 12px 16px;
  }
  .contact-trust svg { color: var(--blue-text); flex-shrink: 0; }
  .trust-link { color: var(--blue-text); text-decoration: none; text-underline-offset: 2px; }
  .trust-link:hover { text-decoration: underline; }

  .form-card {
    background: var(--surface-1);
    border: 1px solid var(--border-sub);
    border-radius: 20px;
    padding: 36px;
  }
  @media (max-width: 639px) { .form-card { padding: 24px; } }
</style>
