---
import MeshCanvas from './MeshCanvas.tsx'
import { Image } from 'astro:assets'
import heroImg from '../assets/gallery/kitchen-1.jpg'
import heroImg2 from '../assets/gallery/bathroom-1.jpg'
---

<section id="hero" class="hero" aria-labelledby="hero-h1">
  <!-- Mesh canvas (React island) -->
  <MeshCanvas client:idle />

  <!-- Dark gradient overlay -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-inner">
    <!-- Content -->
    <div class="hero-content" data-reveal>
      <span class="eyebrow">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Which? Trusted Traders · Est. 2018
      </span>

      <h1 id="hero-h1">Kitchens, Bathrooms &amp; Renovations<br /><span class="hero-em">in Warwickshire — Done Properly.</span></h1>

      <p class="hero-sub">
        RJW Renovations delivers kitchens, bathrooms, and full property renovations
        across Warwickshire and the West Midlands — on time, on budget, built to last.
      </p>

      <div class="hero-stars" aria-label="Rated 5.0 out of 5 from 17 reviews">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span>5.0 · 17 reviews · 100% recommendation rate</span>
      </div>

      <div class="hero-ctas">
        <a href="#contact" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Get a Free Quote
        </a>
        <a href="https://wa.me/447896051540" target="_blank" rel="noopener noreferrer nofollow" class="btn btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Message on WhatsApp<span class="sr-only"> (opens WhatsApp)</span>
        </a>
      </div>
    </div>

    <!-- Feature images -->
    <div class="hero-images" aria-hidden="true">
      <div class="hero-img-wrap hero-img-1">
        <Image
          src={heroImg}
          alt=""
          width={480}
          height={360}
          fetchpriority="high"
          loading="eager"
          quality={85}
        />
      </div>
      <div class="hero-img-wrap hero-img-2">
        <Image
          src={heroImg2}
          alt=""
          width={360}
          height={270}
          loading="eager"
          fetchpriority="high"
          quality={80}
        />
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--bg);
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(135deg, rgba(13,17,23,0.92) 0%, rgba(13,17,23,0.7) 50%, rgba(13,17,23,0.4) 100%);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    padding-top: calc(var(--nav-h) + 40px);
    padding-bottom: 80px;
    align-items: center;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 600px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  h1 .hero-em {
    color: var(--red);
  }
  .hero-sub {
    font-size: clamp(16px, 2vw, 19px);
    color: var(--text-muted);
    max-width: 500px;
    line-height: 1.6;
  }
  .hero-stars {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-muted);
  }
  .hero-stars .stars { font-size: 18px; }
  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Feature images */
  .hero-images {
    display: none;
    position: relative;
  }
  .hero-img-wrap {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  }
  .hero-img-wrap img { display: block; width: 100%; height: auto; object-fit: cover; }
  .hero-img-1 { width: 340px; }
  .hero-img-2 {
    width: 260px;
    position: absolute;
    bottom: -30px;
    right: -20px;
    border: 3px solid var(--surface-1);
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: var(--text-muted);
    animation: bounce 2s ease-in-out infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: 1fr 1fr; }
    .hero-images { display: block; height: 320px; }
  }
  @media (min-width: 1100px) {
    .hero-images { height: 400px; }
    .hero-img-1 { width: 420px; }
    .hero-img-2 { width: 300px; }
  }
</style>
