---
const reviews = [
  {
    name: 'Bob Walshaw',
    location: 'West Midlands',
    rating: 5,
    date: 'February 2026',
    text: 'Done many jobs for us including loft hatch work and bathroom. Always on time, clean and tidy, and willing to offer advice. Great price and friendly service throughout.',
    project: 'Multiple renovations',
  },
  {
    name: 'Verified customer',
    location: 'West Midlands',
    rating: 5,
    date: 'June 2026',
    text: 'Rhys and Alex came to change the decking on my balcony. They arrived on time, were very welcoming and professional. Really pleased with the outcome and will recommend them.',
    project: 'Balcony decking',
  },
  {
    name: 'Verified customer',
    location: 'West Midlands',
    rating: 5,
    date: 'April 2026',
    text: 'Ripped out old en-suite and replaced with a new one. Great communication, high-quality finish, and kept the house tidy throughout. Trusted and reliable from start to finish.',
    project: 'En-suite renovation',
  },
  {
    name: 'Verified customer',
    location: 'Warwickshire',
    rating: 5,
    date: 'November 2025',
    text: 'Completely renewed and remodelled my bathroom. Meticulous attention to detail — skilled, knowledgeable, and trustworthy. Work completed exactly as scheduled and to budget.',
    project: 'Full bathroom remodel',
  },
  {
    name: 'Verified customer',
    location: 'West Midlands',
    rating: 5,
    date: 'February 2025',
    text: 'Thorough, high-quality installation across three new wet rooms. Attention to detail was exceptional — they also rectified several flaws left by the main builder.',
    project: 'Three wet rooms',
  },
  {
    name: 'Verified customer',
    location: 'West Midlands',
    rating: 5,
    date: 'August 2024',
    text: 'Done a lounge renovation with media wall and a full kitchen diner renovation. Prompt, professional, and pleasant throughout. Clean, tidy, and to an excellent standard every time.',
    project: 'Media wall & kitchen diner',
  },
]

const stars = (n: number) => '★'.repeat(n)
---

<section id="reviews" class="testimonials section-py" aria-labelledby="reviews-h2">
  <div class="container">
    <header class="section-header" data-reveal>
      <span class="eyebrow">Customer Reviews</span>
      <h2 id="reviews-h2">What Our Customers Say</h2>
      <p class="reviews-meta">
        <strong class="review-score">5.0</strong> out of 5 — 17 verified reviews on
        <a href="https://trustedtraders.which.co.uk/businesses/rjw-renovations/" rel="noopener noreferrer" target="_blank" class="which-link">Which? Trusted Traders<span class="sr-only"> (opens in new tab)</span></a>
      </p>
    </header>

    <ul class="reviews-grid" role="list">
      {reviews.map((r, i) => (
        <li class="review-card" data-reveal data-delay={String((i % 3) + 1)}>
          <div class="review-top">
            <div class="reviewer-info">
              <div class="reviewer-avatar" aria-hidden="true">{r.name.charAt(0)}</div>
              <div>
                <strong>{r.name}</strong>
                <span class="reviewer-location">{r.location}</span>
              </div>
            </div>
            <time class="review-date" datetime={r.date}>{r.date}</time>
          </div>
          <div class="review-stars" role="img" aria-label={`${r.rating} out of 5 stars`}>
            <span aria-hidden="true">{stars(r.rating)}</span>
          </div>
          <blockquote>
            <p>"{r.text}"</p>
          </blockquote>
          <span class="review-project">{r.project}</span>
        </li>
      ))}
    </ul>

    <div class="reviews-cta" data-reveal>
      <a
        href="https://trustedtraders.which.co.uk/businesses/rjw-renovations/"
        rel="noopener noreferrer"
        target="_blank"
        class="btn btn-secondary"
        aria-label="Read all reviews on Which? Trusted Traders (opens in new tab)"
      >
        Read all 17 reviews on Which?
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .testimonials { background: var(--surface-1); }

  .reviews-meta {
    font-size: 15px;
    color: var(--text-muted);
    margin-top: 8px;
  }
  .review-score {
    font-size: 22px;
    color: var(--gold);
    font-weight: 700;
  }
  .which-link {
    color: var(--blue-text);
    text-underline-offset: 3px;
  }

  .reviews-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 48px;
  }
  @media (min-width: 640px) { .reviews-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .reviews-grid { grid-template-columns: repeat(3, 1fr); } }

  .review-card {
    background: var(--surface-3);
    border: 1px solid var(--border-sub);
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 0.2s;
  }
  .review-card:hover { border-color: var(--blue); }

  .review-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }
  .reviewer-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .reviewer-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(61,110,150,0.2);
    border: 1px solid rgba(61,110,150,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--blue-text);
    flex-shrink: 0;
  }
  .reviewer-info strong {
    display: block;
    font-size: 14px;
    color: var(--text);
    line-height: 1.2;
  }
  .reviewer-location {
    font-size: 12px;
    color: var(--text-muted);
  }
  .review-date {
    font-size: 11px;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .review-stars {
    font-size: 14px;
    color: var(--gold);
    letter-spacing: 1px;
  }

  .review-card blockquote {
    flex: 1;
  }
  .review-card blockquote p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    font-style: italic;
  }

  .review-project {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-subtle);
    background: rgba(61,110,150,0.08);
    border: 1px solid rgba(61,110,150,0.15);
    padding: 3px 8px;
    border-radius: 4px;
    align-self: flex-start;
  }

  .reviews-cta { text-align: center; }
  .reviews-cta .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
</style>
