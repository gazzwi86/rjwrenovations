---
import { PHONE_E164, PHONE_DISPLAY } from '../config/contact'
---

<div
  id="sticky-bar"
  class="sticky-bar"
  role="complementary"
  aria-label="Quick contact"
  data-hidden="true"
>
  <a href={`tel:${PHONE_E164}`} class="sticky-cta sticky-call" rel="nofollow" aria-label={`Call RJW Renovations on ${PHONE_DISPLAY}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1 19.79 19.79 0 0 1 1.62 4.53 2 2 0 0 1 3.62 2.35h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.08 6.08l.96-.96a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.98 17v-.08z"/>
    </svg>
    {PHONE_DISPLAY}
  </a>
  <a href="#contact" class="sticky-cta sticky-quote">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    Free Quote
  </a>
</div>

<script>
  const bar = document.getElementById('sticky-bar')
  if (bar) {
    let ticking = false
    function checkScroll() {
      bar.dataset.hidden = window.scrollY > 200 ? 'false' : 'true'
    }
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => { checkScroll(); ticking = false })
        ticking = true
      }
    }, { passive: true })
  }
</script>

<style>
  .sticky-bar {
    display: none;
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 150;
    background: var(--surface-2);
    border-top: 1px solid var(--border-sub);
    padding: 10px 16px;
    gap: 10px;
    backdrop-filter: blur(12px);
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }
  @media (max-width: 767px) {
    .sticky-bar { display: flex; }
  }
  .sticky-bar[data-hidden="false"] { transform: translateY(0); }

  .sticky-cta {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    min-height: 48px;
    transition: opacity 0.15s;
  }
  .sticky-cta:hover { opacity: 0.9; }

  .sticky-call {
    background: var(--surface-3);
    border: 1px solid var(--border-sub);
    color: var(--text);
  }
  .sticky-quote {
    background: var(--red);
    color: #fff;
    box-shadow: 0 4px 16px rgba(204,34,41,0.3);
  }
</style>
