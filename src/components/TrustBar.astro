---
<section class="trust-bar" aria-label="Trust signals and accreditations">
  <div class="container trust-inner">
    <div class="trust-item" data-reveal data-delay="1">
      <a href="https://trustedtraders.which.co.uk/businesses/rjw-renovations/" rel="noopener noreferrer" target="_blank" class="trust-badge-link" aria-label="View RJW Renovations on Which? Trusted Traders (opens in new tab)">
        <strong>Which? Trusted Traders</strong>
        <span>Independently accredited</span>
        <span class="sr-only">(opens in new tab)</span>
      </a>
    </div>

    <div class="trust-sep" aria-hidden="true"></div>

    <div class="trust-item" data-reveal data-delay="2">
      <strong>5.0 / 5.0</strong>
      <span class="trust-stars" aria-label="Five stars">★★★★★ 17 reviews</span>
    </div>

    <div class="trust-sep" aria-hidden="true"></div>

    <div class="trust-item" data-reveal data-delay="3">
      <strong>100%</strong>
      <span>Recommendation rate</span>
    </div>

    <div class="trust-sep" aria-hidden="true"></div>

    <div class="trust-item" data-reveal data-delay="4">
      <strong>Est. 2018</strong>
      <span>6+ years trusted locally</span>
    </div>
  </div>
</section>

<style>
  .trust-bar {
    background: var(--surface-1);
    border-top: 1px solid var(--border-sub);
    border-bottom: 1px solid var(--border-sub);
    padding: 28px 0;
  }
  .trust-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 16px;
    align-items: center;
  }
  .trust-sep { display: none; }
  .trust-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .trust-badge-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s;
  }
  .trust-badge-link:hover { opacity: 0.8; }
  .trust-item strong {
    display: block;
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
  }
  .trust-item span:not(.trust-stars) {
    display: block;
    font-size: 13px;
    color: var(--text-muted);
  }
  .trust-stars {
    display: block;
    color: var(--gold);
    font-size: 13px;
    letter-spacing: 1px;
  }

  @media (min-width: 640px) {
    .trust-inner {
      display: flex;
      align-items: center;
      gap: 0;
    }
    .trust-item {
      flex: 1;
      justify-content: center;
    }
    .trust-sep {
      display: block;
      flex-shrink: 0;
      width: 1px;
      height: 40px;
      background: var(--border-sub);
    }
  }
</style>
