---
import { PHONE_E164, PHONE_DISPLAY, EMAIL, WA_URL_BARE } from '../config/contact'

const year = new Date().getFullYear()

const services = [
  'Kitchens', 'Bathrooms', 'Wet Rooms', 'Accessible Bathrooms',
  'Plumbing', 'Boiler & Heating', 'Media Walls', 'Decking',
  'Garage Conversions', 'Fencing',
]

const links = [
  { href: '#services', label: 'Services' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#why-us', label: 'Why Choose Us' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#about', label: 'About' },
  { href: '#areas', label: 'Areas Covered' },
  { href: '#contact', label: 'Contact' },
]
---

<footer class="footer" aria-label="Site footer">
  <div class="container">
    <div class="footer-grid">

      <!-- Brand col -->
      <div class="footer-brand">
        <a href="/" aria-label="RJW Renovations — back to top">
          <img src="/logo.png" alt="RJW Renovations logo" width="182" height="80" class="footer-logo" />
        </a>
        <p>Quality renovations across Warwickshire and the West Midlands. Which? Trusted Traders accredited.</p>
        <div class="footer-social">
          <a href="https://www.facebook.com/RJWreno/" rel="noopener noreferrer" target="_blank" class="social-link" aria-label="RJW Renovations on Facebook (opens in new tab)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://www.instagram.com/rjwreno/" rel="noopener noreferrer" target="_blank" class="social-link" aria-label="RJW Renovations on Instagram (opens in new tab)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href={WA_URL_BARE} rel="noopener noreferrer nofollow" target="_blank" class="social-link" aria-label="WhatsApp RJW Renovations (opens in new tab)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>

      <!-- Services col -->
      <nav aria-label="Services navigation">
        <h3 class="footer-heading">Services</h3>
        <ul class="footer-list" role="list">
          {services.map(s => (
            <li><a href="#services">{s}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Quick links col -->
      <nav aria-label="Quick links">
        <h3 class="footer-heading">Quick Links</h3>
        <ul class="footer-list" role="list">
          {links.map(l => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Contact col -->
      <div class="footer-contact">
        <h3 class="footer-heading">Get in Touch</h3>
        <ul class="footer-contact-list" role="list">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1 19.79 19.79 0 0 1 1.62 4.53 2 2 0 0 1 3.62 2.35h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.08 6.08l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.98 17v-.08z"/></svg>
            <a href={`tel:${PHONE_E164}`} class="footer-contact-link" rel="nofollow">{PHONE_DISPLAY}</a>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href={`mailto:${EMAIL}`} class="footer-contact-link" rel="nofollow">{EMAIL}</a>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Henley-in-Arden, Warwickshire</span>
          </li>
        </ul>

        <div class="footer-hours">
          <strong>Mon–Fri</strong> 7am – 6pm<br />
          <strong>Sat</strong> 8am – 2pm<br />
          <strong>Sun</strong> Closed
        </div>
      </div>

    </div>

    <div class="footer-bottom">
      <p>© {year} RJW Renovations. All rights reserved. Registered in England.</p>
      <p>
        <a href="https://trustedtraders.which.co.uk/businesses/rjw-renovations/" rel="noopener noreferrer" target="_blank" class="which-footer-link">Which? Trusted Traders<span class="sr-only"> (opens in new tab)</span></a>
        &nbsp;·&nbsp; Built with care for quality.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-1);
    border-top: 1px solid var(--border-sub);
    padding: 64px 0 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  @media (min-width: 640px) { .footer-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr 1.5fr; gap: 40px; } }

  .footer-logo {
    height: 56px;
    width: auto;
    margin-bottom: 16px;
  }
  .footer-brand p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 20px;
    max-width: 280px;
  }
  .footer-social { display: flex; gap: 10px; }
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px; height: 38px;
    background: var(--surface-3);
    border: 1px solid var(--border-sub);
    border-radius: 8px;
    color: var(--text-muted);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .social-link:hover { border-color: var(--blue); color: var(--blue-text); }

  .footer-heading {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    margin-bottom: 16px;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-list a {
    font-size: 14px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-list a:hover { color: var(--text); }

  .footer-contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 20px;
  }
  .footer-contact-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-muted);
    font-size: 14px;
  }
  .footer-contact-list svg { flex-shrink: 0; color: var(--blue-text); }
  :global(.footer-contact-link) {
    color: var(--text-muted) !important;
    text-decoration: none !important;
    transition: color 0.15s;
  }
  :global(.footer-contact-link:hover) { color: var(--text) !important; }

  .footer-hours {
    background: var(--surface-3);
    border: 1px solid var(--border-sub);
    border-radius: 10px;
    padding: 14px 16px;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.8;
  }
  .footer-hours strong { color: var(--text); }

  .footer-bottom {
    border-top: 1px solid var(--border-sub);
    padding: 20px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: space-between;
    align-items: center;
  }
  .footer-bottom p {
    font-size: 13px;
    color: var(--text-subtle);
  }
  .which-footer-link {
    color: var(--blue-text);
    text-decoration: none;
    text-underline-offset: 2px;
  }
  .which-footer-link:hover { text-decoration: underline; }
</style>
